# ===========================================
# PROOF OF WEAR - Environment Variables
# ===========================================
#
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Never commit .env.local to version control!

# ===========================================
# NWC Connection (Production Wallet)
# ===========================================
# This wallet receives real payments from customers.
# Get your NWC URL from: Alby Hub, coinos, Primal, or lnwallet.app
# Format: nostr+walletconnect://[pubkey]?relay=[relay]&secret=[secret]
NWC_URL=

# ===========================================
# Test Wallets (Optional - for E2E testing)
# ===========================================
# These wallets should have small amounts for testing.
# Used by the /pipeline-test page for automated testing.
NWC_TEST_WALLET_A=
NWC_TEST_WALLET_B=
